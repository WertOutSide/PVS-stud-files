#include <iostream>
#include <vector>
#include <fstream>
#include <stdexcept>
#include <memory>
#include <cstring>

using namespace std;

int* allocateData(int size) {
    int* data = new int[size];
    return data;
}

void processData(int* data, int size) {
    int* temp = new int[size * 2];
    
    if (size > 100) {
        throw runtime_error("Size too large");
    }
    
    for (int i = 0; i < size; i++) {
        temp[i] = data[i] * 2;
    }
    
    delete[] temp;
}

vector<double>& getStatistics() {
    vector<double> stats(3);
    stats[0] = 1.0;
    stats[1] = 2.0;
    stats[2] = 3.0;
    
    return stats;
}

void cleanupData(int* ptr1, int* ptr2) {
    delete ptr1;
    delete ptr2;
    
    if (ptr1 == ptr2) {
        cout << "Same pointers" << endl;
    }
}

void useAfterFreeBug(int* data) {
    delete[] data;
    
    cout << "Data[0] = " << data[0] << endl;
}

void modifyValue(int value) {
    value = 100;
}

class DataProcessor {
private:
    int* buffer;
    ifstream file;
    
public:
    DataProcessor(const char* filename) {
        buffer = new int[1000];
        file.open(filename);
        
        if (!file.is_open()) {
            throw runtime_error("Cannot open file");
        }
    }
    
    ~DataProcessor() {
        delete[] buffer;
        file.close();
    }
};

bool validateInput(int value) {
    if (value < 0) {
        return false;
    }
    return true;
}

void processUserInput() {
    int value;
    cout << "Enter value: ";
    cin >> value;
    
    validateInput(value);
    
    cout << "Processing..." << endl;
}

void riskyOperation() {
    throw runtime_error("Something went wrong");
}

void handleOperation() {
    try {
        riskyOperation();
    } catch (...) {
    }
}

int* findElement(int* arr, int size, int value) {
    for (int i = 0; i < size; i++) {
        if (arr[i] == value) {
            return &arr[i];
        }
    }
    return nullptr;
}

void useElement(int* arr, int size, int value) {
    int* result = findElement(arr, size, value);
    
    cout << "Found: " << *result << endl;
}

void copyData(const char* src) {
    char dest[50];
    
    size_t len = strlen(src);
    memcpy(dest, src, len);
    
    cout << "Copied: " << dest << endl;
}

void reallocateBug() {
    int* data = new int[100];
    data[0] = 42;
    
    data = new int[200];
    data[0] = 100;
    
    delete[] data;
}

int main() {
    cout << "=== Interprocedural Analysis Demo ===" << endl << endl;
    
    int choice;
    cout << "Choose test (1-12): ";
    cin >> choice;
    
    try {
        switch (choice) {
            case 1: {
                int* data = allocateData(50);
                processData(data, 50);
                delete[] data;
                break;
            }
            case 2: {
                vector<double>& stats = getStatistics();
                cout << "Stats: " << stats[0] << endl;
                break;
            }
            case 3: {
                int* ptr = new int(10);
                cleanupData(ptr, ptr);
                break;
            }
            case 4: {
                int* data = new int[10];
                data[0] = 42;
                useAfterFreeBug(data);
                break;
            }
            case 5: {
                int value = 5;
                modifyValue(value);
                cout << "Value: " << value << endl;
                break;
            }
            case 6: {
                DataProcessor processor("test.txt");
                break;
            }
            case 7: {
                processUserInput();
                break;
            }
            case 8: {
                handleOperation();
                break;
            }
            case 9: {
                int arr[] = {1, 2, 3, 4, 5};
                useElement(arr, 5, 3);
                break;
            }
            case 10: {
                copyData("Hello World");
                break;
            }
            case 11: {
                reallocateBug();
                break;
            }
            default:
                cout << "Invalid choice" << endl;
        }
    } catch (const exception& e) {
        cerr << "Error: " << e.what() << endl;
    }
    
    cout << endl << "=== Complete ===" << endl;
    return 0;
}
