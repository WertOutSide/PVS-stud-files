void processData(const char* inputFile, const char* outputFile) {
    vector<double> data = readDataFromFile(inputFile);
    
    if (data.empty()) {
        throw runtime_error("No data to process");
    }
    
    double mean = calculateMean(data);
    double stddev = calculateStdDev(data, mean);
    
    double minVal, maxVal;
    findMinMax(data, minVal, maxVal);
    
    writeResults(outputFile, mean, stddev, minVal, maxVal);
    
    cout << "Processing complete!" << endl;
}

void demonstrateBufferIssue() {
    char buffer[100];
    
    cout << "Enter text (max 99 chars): ";
    string input;
    getline(cin, input);
    
    strncpy(buffer, input.c_str(), sizeof(buffer) - 1);
    buffer[sizeof(buffer) - 1] = '\0';
    
    cout << "Stored: " << buffer << endl;
}

void demonstratePointerIssue(int value) {
    int* ptr = nullptr;
    int localValue = value * 2;
    
    if (value > 0) {
        ptr = &localValue;
    }
    
    if (ptr != nullptr) {
        cout << "Pointer value: " << *ptr << endl;
    }
}

void demonstrateMemoryIssue(int count) {
    if (count <= 0 || count > 1000) {
        cout << "Invalid count" << endl;
        return;
    }
    
    int* data = new int[count];
    
    for (int i = 0; i < count; i++) {
        data[i] = i * 2;
    }
    
    cout << "First value: " << data[0] << endl;
    
    delete[] data;
}

