void processData(const char* inputFile, const char* outputFile) {
    vector<double> data = readDataFromFile(inputFile);
    
    double mean = calculateMean(data);
    double stddev = calculateStdDev(data, mean);
    
    double minVal, maxVal;
    findMinMax(data, minVal, maxVal);
    
    writeResults(outputFile, mean, stddev, minVal, maxVal);
    
    cout << "Processing complete!" << endl;
}

bool getUserInput(int& count) {
    cout << "Enter number of values: ";
    cin >> count;
    
    if (count <= 0) {
        cerr << "Error: Count must be positive!" << endl;
        return false;
    }
    
    if (cin.fail()) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cerr << "Error: Invalid input!" << endl;
        return false;
    }
    
    return true;
}

int main() {
    cout << "=== Statistics Calculator ===" << endl << endl;
    
    int choice;
    cout << "Choose mode:" << endl;
    cout << "1. Read from file" << endl;
    cout << "2. Manual input" << endl;
    cout << "Enter choice: ";
    cin >> choice;
    
    try {
        if (choice == 1) {
            string inputFile, outputFile;
            cout << "Enter input filename: ";
            cin >> inputFile;
            cout << "Enter output filename: ";
            cin >> outputFile;
            
            processData(inputFile.c_str(), outputFile.c_str());
            
            ifstream resultFile(outputFile);
            if (resultFile.is_open()) {
                cout << endl << "Results:" << endl;
                string line;
                while (getline(resultFile, line)) {
                    cout << line << endl;
                }
                resultFile.close();
            }
            
        } else if (choice == 2) {
            int count;
            if (!getUserInput(count)) {
                return 1;
            }
            
            vector<double> userData(count);
            cout << "Enter " << count << " values:" << endl;
            
            for (int i = 0; i < count; i++) {
                cout << "Value " << (i+1) << ": ";
                cin >> userData[i];
                
                if (cin.fail()) {
                    cin.clear();
                    cin.ignore(numeric_limits<streamsize>::max(), '\n');
                    cerr << "Invalid number! Try again." << endl;
                    i--;
                }
            }
            
            double mean = calculateMean(userData);
            double stddev = calculateStdDev(userData, mean);
            double minVal, maxVal;
            findMinMax(userData, minVal, maxVal);
            
            cout << endl << "Results:" << endl;
            cout << "Mean: " << mean << endl;
            cout << "StdDev: " << stddev << endl;
            cout << "Min: " << minVal << endl;
            cout << "Max: " << maxVal << endl;
            
        } else {
            cerr << "Invalid choice!" << endl;
            return 1;
        }
        
    } catch (const exception& e) {
        cerr << "Error: " << e.what() << endl;
        return 1;
    }
    
    cout << endl << "=== Complete ===" << endl;
    return 0;
}
