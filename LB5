#include <iostream>
#include <vector>
#include <fstream>
#include <cstring>

using namespace std;

void bufferOverflow() {
    char buffer[10];
    strcpy(buffer, "This is a very long string that will overflow");
    cout << buffer << endl;
}

void nullPointerDeref() {
    int* ptr = nullptr;
    *ptr = 42;
    cout << *ptr << endl;
}

void uninitializedVar() {
    int x;
    cout << x << endl;
}

void memoryLeak() {
    int* data = new int[100];
    data = new int[200];
    delete[] data;
}

void doubleFree() {
    int* ptr = new int(5);
    delete ptr;
    delete ptr;
}

void useAfterFree() {
    char* buffer = new char[64];
    delete[] buffer;
    strcpy(buffer, "test");
}

void divisionByZero(int x) {
    int result = 100 / x;
    cout << result << endl;
}

void arrayOutOfBounds() {
    int arr[10];
    arr[15] = 42;
    cout << arr[15] << endl;
}

int main() {
    cout << "=== Test ===" << endl;
    
    bufferOverflow();
    nullPointerDeref();
    uninitializedVar();
    memoryLeak();
    doubleFree();
    useAfterFree();
    divisionByZero(0);
    arrayOutOfBounds();
    
    return 0;
}
